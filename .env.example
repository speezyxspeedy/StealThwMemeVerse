# PORT: Express + Socket.IO server port (defaults to 3000)
PORT="3000"

# DATABASE_URL: Optional PostgreSQL connection string for Prisma persistence (see prisma/schema.prisma)
# When omitted, the game server automatically persists player saves locally in data/memeverse-save.json.
DATABASE_URL="postgresql://user:password@localhost:5432/memeverse?schema=public"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"
